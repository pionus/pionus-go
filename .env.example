# Environment variables for pionus-go
# Copy to .env and fill in values

# Token for protected JSON API writes
PIONUS_AUTH_TOKEN=

# Server address (default: :8087)
# PIONUS_ADDR=:8087

# Database path (default: ./data/pionus.db)
# PIONUS_DB_PATH=./data/pionus.db

# IANA timezone (default: Asia/Shanghai)
# PIONUS_TIMEZONE=Asia/Shanghai

# Uploads
# PIONUS_UPLOAD_DIR=./uploads
# PIONUS_UPLOAD_MAX_MB=10

# Admin sessions
# PIONUS_SESSION_COOKIE=pionus_session
# PIONUS_SESSION_TTL_HOURS=168
# PIONUS_SESSION_SECURE=1

# Password used by: ./pionus -create-admin <username>
# PIONUS_ADMIN_PASSWORD=
